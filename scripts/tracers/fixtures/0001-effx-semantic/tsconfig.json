{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2024",
    "types": [],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "diagnosticSeverity": {
          "floatingEffect": "error",
          "missingEffectContext": "error"
        }
      }
    ],
    "skipLibCheck": true
  },
  "files": [
    "fixtures/aliases.ts",
    "fixtures/floating.ts",
    "fixtures/clean.ts",
    "fixtures/relation.ts"
  ]
}
