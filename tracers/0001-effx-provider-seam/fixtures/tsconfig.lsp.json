{
  "compilerOptions": {
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "skipLibCheck": true,
    "types": ["bun"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "diagnosticSeverity": {
          "floatingEffect": "error"
        }
      }
    ]
  },
  "files": ["lsp.ts"]
}
